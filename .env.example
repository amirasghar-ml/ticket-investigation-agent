# Optional. When unset, the agent uses deterministic demo reasoning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. When unset, GitHub tool returns seeded demo commits/PRs.
GITHUB_TOKEN=
GITHUB_REPO=acme/webapp

# Demo SQLite database (created automatically on first run)
DATABASE_URL=sqlite:///./data/support_agent.db
